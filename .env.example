# ─────────────────────────────────────────────────────────────
# RIDE APP — Environment Variables
# Copy this to .env.local for local dev (already filled for Docker)
# Copy to .env.keys for cloud deployment (fill from SETUP_GUIDE.md)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────
# Local: postgres://postgres:postgres@localhost:5432/rideapp
# Cloud: get from neon.tech dashboard → Connection Details → Pooled connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rideapp
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/rideapp

# ── Redis ─────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Cloud: get from upstash.com → Redis → Connect → Node.js URL
REDIS_URL=redis://localhost:6379

# ── MongoDB ───────────────────────────────────────────────────
# Local: mongodb://localhost:27017/rideapp
# Cloud: get from mongodb.com/atlas → Connect → Drivers
MONGODB_URL=mongodb://localhost:27017/rideapp

# ── Kafka removed ─────────────────────────────────────────────
# Replaced with Redis Streams (uses the REDIS_URL above — no extra service)

# ── Auth / JWT ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-local-access-secret
JWT_REFRESH_SECRET=change-me-local-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Firebase ──────────────────────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Frontend Firebase config (from Firebase Console → Project Settings → General → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Razorpay (test mode) ──────────────────────────────────────
# Get from razorpay.com → Settings → API Keys → Test Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Cloudinary (KYC document uploads) ────────────────────────
# Get from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Resend (email receipts) ───────────────────────────────────
# Get from resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=receipts@yourdomain.com

# ── Service URLs (local dev) ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3100
NEXT_PUBLIC_WS_URL=ws://localhost:3200
AUTH_SERVICE_URL=http://localhost:3101
USER_SERVICE_URL=http://localhost:3102
DRIVER_SERVICE_URL=http://localhost:3103
LOCATION_SERVICE_URL=http://localhost:3104
RIDE_SERVICE_URL=http://localhost:3105
MATCHING_SERVICE_URL=http://localhost:3106
PRICING_SERVICE_URL=http://localhost:3107
PAYMENT_SERVICE_URL=http://localhost:3108
NOTIFICATION_SERVICE_URL=http://localhost:3109
RATING_SERVICE_URL=http://localhost:3110

# ── Internal service secret (for service-to-service calls) ───
INTERNAL_SERVICE_SECRET=change-me-internal-secret

# ── Dev mode shortcuts ────────────────────────────────────────
# Set to true to skip Firebase and accept OTP "000000" for any phone
DEV_BYPASS_OTP=true
DEV_BYPASS_OTP_VALUE=000000
